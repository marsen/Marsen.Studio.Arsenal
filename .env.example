# 本機開發複製此檔案為 .env.local 並填入實際值

# 網站的完整 base URL
# SEO 功能（sitemap、robots、canonical URL）需要此值，未設定會 fail fast
# 其餘功能（如 Instagram OAuth callback）本機開發可省略，會自動從 request 推算
NEXT_PUBLIC_BASE_URL=https://demo.marsen.me

# Resend API Key（聯絡表單發信用）
# 取得方式：https://resend.com → API Keys
RESEND_API_KEY=

# 後台功能（登入、Landing Page 內容管理）需要的資料庫連線
# 取得方式：Vercel 專案 → Storage → 建立 Neon Postgres
# 未設定時，公開頁面會優雅降級成預設內容；後台功能會 fail fast
DATABASE_URL=

# 後台 session 簽章金鑰（任意長度足夠的隨機字串，例如 openssl rand -base64 32）
AUTH_SECRET=
# session 有效期間，jose 的時間格式（如 7d、12h）
AUTH_TOKEN_TTL=7d

# 只給 `pnpm db:seed` 腳本用，建立第一個後台帳號後可以清掉，不會被程式讀取
SEED_ADMIN_USERNAME=
SEED_ADMIN_PASSWORD=
