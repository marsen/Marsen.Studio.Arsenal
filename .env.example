# 本機開發複製此檔案為 .env.local 並填入實際值

# 網站的完整 base URL（部署後填入，本機開發可省略，會自動從 request 推算）
# NEXT_PUBLIC_BASE_URL=https://marsen.me

# Neon PostgreSQL
DATABASE_URL=

# Resend（Email 通知）
RESEND_API_KEY=
RESEND_FROM_EMAIL=     # 在 Resend 已驗證的寄件地址，例如 noreply@yourdomain.com
ADMIN_EMAIL=           # 收聯絡通知的信箱（你自己的）

# 後台認證
ADMIN_PASSWORD=        # 自訂後台登入密碼
ADMIN_SESSION_SECRET=  # 至少 32 字元隨機字串，可用 openssl rand -base64 32 產生
